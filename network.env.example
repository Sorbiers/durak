# Shared tables: a game with invited people, dealt and judged by a small service on the server.
# Copy to network.env to offer them. network.env is not committed; without it they are off.
#
# NETWORK=on   the game has an Invite tab in Settings; deploy.sh installs and starts the service.
# NETWORK=off  no Invite tab; deploy.sh stops the service and keeps it from starting again.
# network.bat stops and starts the service at any time, without a deploy.
NETWORK=on
# The service's port on the server itself, behind nginx. Any port nothing else there uses.
NETWORK_PORT=8083
# Tables in use at once; a new one is refused beyond this.
NETWORK_MAX_GAMES=10
# Invited people at one table, 1 to 3.
NETWORK_MAX_GUESTS=3
# A table is kept this long after it was last played at.
NETWORK_KEEP_HOURS=12
